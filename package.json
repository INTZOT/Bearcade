{
  "name": "bearcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bearcade 基岩版小游戏服务器(分包解耦 + 容器化房间)",
  "scripts": {
    "gen:uuid": "node -e \"console.log(crypto.randomUUID())\"",
