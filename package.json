    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "watch": "node scripts/watch.mjs"
  },
  "devDependencies": {
    "@minecraft/common": "1.3.0",
    "@minecraft/server": "2.10.0-beta.1.26.43-stable",
    "@minecraft/server-ui": "2.2.0-beta.1.26.43-stable",
    "@minecraft/vanilla-data": "1.26.40",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
