{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "green_beret:leaf_rise_stream",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/leaf"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "variable.right.x * (variable.particle_random_1 - 0.5) * 0.6",
          0,
          "variable.right.z * (variable.particle_random_1 - 0.5) * 0.6"
        ],
        "direction": [
          "variable.dir.x",
          "variable.dir.y",
          "variable.dir.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_1 * 360",
        "rotation_rate": "(variable.particle_random_4 - 0.5) * 720"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15 * (0.65 + variable.particle_random_2 * 0.65)",
          "0.1 * (0.65 + variable.particle_random_2 * 0.65)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 24,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            24,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.72 + variable.particle_random_3 * 0.28",
          1,
          "0.7 + variable.particle_random_2 * 0.3",
          "math.clamp(1 - (variable.particle_age - variable.fade_delay) / 0.2, 0, 1)"
        ]
      },
      "minecraft:particle_initial_speed": [
        "variable.dir.x * variable.speed",
        "variable.dir.y * variable.speed",
        "variable.dir.z * variable.speed"
      ],
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0
      }
    }
  }
}
