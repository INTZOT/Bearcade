        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 24,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            24,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.72 + variable.particle_random_3 * 0.28",
