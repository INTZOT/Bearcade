          "variable.right.z * math.cos(variable.particle_random_1 * 360) * (0.18 + variable.particle_random_3 * 0.25)"
        ],
        "direction": [
          "variable.dir.x",
          0,
          "variable.dir.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.23
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_1 * 360",
        "rotation_rate": "(variable.particle_random_4 - 0.5) * 720"
