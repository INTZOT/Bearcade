{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "jimie:totem_hand_visual",
      "item": {
        "minecraft:totem_of_undying": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/totem",
        "hidden": "textures/items/jimie_totem_hidden",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.jimie_totem_hand"
      },
      "animations": {
        "first_person": "animation.jimie.hand_first_person",
        "third_person": "animation.jimie.hand_hidden",
        "hidden_invisible": "animation.jimie.hand_invisible"
      },
      "scripts": {
        "animate": [
          { "first_person": "context.is_first_person == 1.0" },
          { "third_person": "context.is_first_person == 0.0" },
          { "hidden_invisible": "query.is_invisible" }
        ]
      },
      "render_controllers": [ "controller.render.jimie_totem" ]
    }
  }
}
